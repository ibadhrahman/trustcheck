# TrustCheck Environment Configuration
# Copy this file to .env and fill in the values
# NEVER commit the actual .env file to version control

# --- Security ---
# Generate a strong secret key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-replace-with-random-hex

# JWT settings
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database ---
# Local development / tests:
DATABASE_URL=sqlite:///./trustcheck.db
# To use the linked Supabase database, replace the value above with the
# PostgreSQL URI from Supabase Dashboard → Project Settings → Database → Connect.
# Use the Session pooler URI if your network does not support IPv6. Keep the
# password in this ignored .env file; never commit it or put it in frontend code.
# Example shape (replace every placeholder with the dashboard's values):
# DATABASE_URL=postgresql://postgres:DB_PASSWORD@db.rwhcqsiuvdtgpgtkzvqc.supabase.co:5432/postgres?sslmode=require
# For the Session pooler, copy its full URI from the dashboard instead.

# --- Application ---
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=5

# --- Duplicate Detection ---
# Perceptual hash similarity threshold (0-64, lower = stricter)
PHASH_SIMILARITY_THRESHOLD=10
# Hours to look back for duplicate reference detection
DUPLICATE_WINDOW_HOURS=168

# --- OCR ---
# Set to "tesseract", "rapidocr", or "auto" (tries both)
OCR_ENGINE=auto

# --- HMAC key for transaction reference fingerprinting ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
HMAC_SECRET=your-hmac-secret-here-replace-with-random-hex

# --- DeepSeek Multimodal AI Engine ---
# Get your API key at https://platform.deepseek.com/ or compatible provider
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://integrate.api.nvidia.com/v1
DEEPSEEK_MODEL=deepseek-v4.1-flash
DEEPSEEK_ENABLED=true
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_RETRIES=0

# --- Gemini Multimodal AI (Optional) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLED=true
GEMINI_TIMEOUT_SECONDS=15
GEMINI_MAX_RETRIES=0
